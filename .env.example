# ==========================================================
# AI AGENT BLACK BOX - ENVIRONMENT CONFIGURATION EXAMPLE
# Copy to .env for local Docker and environment overrides
# ==========================================================

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/blackboxdb
DB_USERNAME=blackbox_user
DB_PASSWORD=blackbox_password
DB_DRIVER=org.postgresql.Driver
HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
FLYWAY_ENABLED=true

# Apache Kafka Configuration
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=ai-agent-events

# Demo Mode & LLM Integration (No key needed for full demo operation)
DEMO_MODE=true
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# Server & Management
SERVER_PORT=8080
